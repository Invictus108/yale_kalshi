FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

DEV_AUTH_BYPASS=false

# Same as Yale_Books ORIGIN — service callback is {APP_BASE_URL}/login_callback
APP_BASE_URL=http://localhost:5000
ORIGIN=http://localhost:5000

# Optional overrides:
# CAS_LOGIN_URL=https://secure-tst.its.yale.edu/cas/login
# CAS_VALIDATE_URL=https://secure-tst.its.yale.edu/cas/p3/serviceValidate

FRIEND_ACCESS_CODE=
BOOTSTRAP_ADMIN_NETID=admin
SEED_BALANCE=10000
LMSR_B=100
DISPUTE_HOURS=24
SEED_DEMO_DATA=false

SMTP_HOST=
